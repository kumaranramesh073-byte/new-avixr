# Q-Simutron Platform — Backend Environment Variables Example
PORT=3100
CORS_ORIGIN=http://localhost:5100
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Grounding search providers (chain: Tavily → DuckDuckGo → xAI)
# TAVILY_API_KEY: free tier 1,000 req/mo — primary, reliable, no IP throttle
TAVILY_API_KEY=your_tavily_api_key_here
# XAI_API_KEY: PAID last-resort fallback only (used when both free providers fail)
XAI_API_KEY=your_xai_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
