# ── Frontend env (set these in Vercel → Project → Settings → Environment Variables) ──
# Base URL of the deployed backend API — MUST include the /api suffix, no trailing slash.
VITE_API_BASE=https://your-backend-host.example.com/api

# WebSocket base for live features (deep research / session stream). Use wss:// in production.
VITE_WS_BASE=wss://your-backend-host.example.com/ws
VITE_WS_URL=wss://your-backend-host.example.com/ws

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
